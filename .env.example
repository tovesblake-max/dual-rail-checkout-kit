# ──────────────────────────────────────────────────────────────────
# Dual-Rail Checkout Kit — environment template
# ──────────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in the values for whichever rail(s)
# you plan to use. You can leave the inactive rail's vars empty —
# the corresponding `/api/checkout/*` route will return a clear
# "credentials not configured" error if it's accidentally hit.
#
# NEVER commit the populated file — `.gitignore` already excludes
# `.env*.local` and `.env`.

# ════════════════════════════════════════════════════════════════════
# THE SWITCH
# ════════════════════════════════════════════════════════════════════
# This single env var picks which rail is active. Both rails stay
# wired in the codebase 24/7 — you don't delete the unused rail.
#
# Valid values (anything else fails the build):
#   cardsshield  → renders the KingsGate iframe (PayPal + cards)
#   psifi        → renders the PsiFi iframe (Apple/Google Pay + cards + crypto)
#
# To flip rails in production: change this value in Vercel + redeploy.
# NEXT_PUBLIC_* vars are inlined at BUILD time, so a fresh deploy is
# required for the new value to take effect.
NEXT_PUBLIC_PRIMARY_CARD_RAIL="cardsshield"

# Public origin of THIS app. Used to construct webhook + redirect
# URLs sent to the payment gateways. Must be the externally-reachable
# URL — gateways can't call back to localhost in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# ════════════════════════════════════════════════════════════════════
# PSIFI RAIL — only required if NEXT_PUBLIC_PRIMARY_CARD_RAIL=psifi
# ════════════════════════════════════════════════════════════════════
# Sign up at https://app.psifi.app for credentials. PsiFi is a
# crypto-settlement gateway with no KYC, no reserve, daily payouts,
# and unified Apple Pay / Google Pay / card / crypto support.
# Rate is ~10% (high but absorbed for the conversion gains).

# Get from https://app.psifi.app → Settings → API Keys
PSIFI_API_KEY=""

# Optional: pin the gateway base URL. Defaults to
# https://api.psifi.app/api/v2 when unset.
# PSIFI_API_BASE="https://api.psifi.app/api/v2"

# Webhook signing secret. PsiFi uses Svix. Format is `ep_<rawstring>`
# (Svix endpoint-secret prefix) or `whsec_<base64>`. Get from the
# Webhook Portal at app.psifi.app → Webhooks → endpoint detail.
# REQUIRED in production — without this, the webhook receiver fails
# closed and won't ACK any incoming events. (A forged
# transaction.updated could trigger fulfillment, so verification is
# load-bearing — never disable.)
PSIFI_WEBHOOK_SECRET=""

# Optional: contextual product id. When set, the hosted page shows
# your product name + image instead of a generic dollar amount line.
# Create one in app.psifi.app → Products and paste its id here.
# PSIFI_DEMO_PRODUCT_ID=""


# ════════════════════════════════════════════════════════════════════
# CARDSSHIELD / KINGSGATE RAIL
#   — only required if NEXT_PUBLIC_PRIMARY_CARD_RAIL=cardsshield
# ════════════════════════════════════════════════════════════════════
# Sign up via https://thekingsgateway.com. KingsGate is a PayPal-
# backed gateway with weekly bank settlement, near-zero chargebacks
# (PayPal owns buyer ID verification), and ~3-4% blended rate.
# Brand note: the product is "KingsGate" but the gateway domain is
# still cardsshield.com — env vars keep the historical CS_ prefix.

# Provisioned per merchant. Dev sandbox is https://dev-gw.cardsshield.com;
# production URL comes from your KingsGate onboarding email.
CS_GATEWAY_URL="https://dev-gw.cardsshield.com"

# Shared key — used in outbound URL query strings AND authenticates
# inbound API 0 calls from KingsGate back to /api/cs/order-detail.
CS_API_KEY=""

# KingsGate-provisioned platform identifier (e.g. "STILLWATERBIO").
CS_PLATFORM_NAME=""

# HMAC secret for refund (API 10.1) and tracking sync (API 10.2).
# Never sent in any request body. Optional in this kit — the refund
# + tracking helpers are stubbed; populate if you wire them up.
# CS_SECRET_KEY=""

# KingsGate-provisioned token returned in API 0's
# `payments.interface_type_param.token` field. Authenticates the
# platform → gateway link inside the embedded iframe.
CS_ENDPOINT_TOKEN=""

# Which underlying processor KingsGate routes through:
#   "1" → PayPal sub-flow (default for this kit's UX)
#   "2" → Stripe sub-flow (server-to-server; the embedded-iframe
#         postMessage choreography this kit ships doesn't apply)
CS_PAYMENT_GATEWAY="1"


# ════════════════════════════════════════════════════════════════════
# QUIKLIE RAIL — only required if NEXT_PUBLIC_PRIMARY_CARD_RAIL=quiklie
# ════════════════════════════════════════════════════════════════════
# Sign up via https://quiklie.com. Quiklie is a high-risk-friendly card
# processor with a Hosted Payment Page (HPP) flow that keeps PCI scope
# at SAQ-A. This kit only ships the HPP path — the S2S endpoint exists
# but expands PCI scope to SAQ-D so we don't expose it.
#
# UX difference vs cardsshield/psifi: Quiklie HPP is a full-page
# redirect, not an embedded iframe. The demo shows an explicit "Pay
# $X.XX" button that the customer clicks to leave for Quiklie's
# hosted page (vs. the auto-firing inline iframe on the other rails).

# Get from Quiklie merchant dashboard → Settings → API.
QUIKLIE_API_KEY=""

# Numeric merchant id assigned during onboarding (e.g. "171").
QUIKLIE_MERCHANT_ID=""

# Optional: pin the gateway base URL. Defaults to https://api.quiklie.com.
# QUIKLIE_API_BASE="https://api.quiklie.com"

# Statement descriptor (max 22 chars) that appears on the cardholder's
# bank statement. Some Quiklie MIDs require this set.
QUIKLIE_DESCRIPTOR="DEMO STORE"

# midType — which Quiklie processor lane your merchant account is
# provisioned on. Default TWO_D (no 3DS challenge). Override only if
# Quiklie support tells you your account is on the 3DS lane —
# otherwise you'll get statusCode 5 "No eligible MIDs available" on
# every mint.
# NEXT_PUBLIC_QUIKLIE_HPP_MIDTYPE="TWO_D"

# Optional: separate API key for webhook auth. If unset, the webhook
# handler accepts your main QUIKLIE_API_KEY in the X-API-Key header.
# Provision a separate one in Quiklie's dashboard if you want to
# rotate webhook auth independently of API auth.
# QUIKLIE_WEBHOOK_API_KEY=""
